@echo off
setlocal enabledelayedexpansion

cd /d "%~dp0"

echo.
echo ============================================================
echo  AI Friend -- Offline Setup
echo  Python 3.10  ^|  CUDA 12.1  ^|  RTX 3050
echo ============================================================
echo.

:: ─────────────────────────────────────────────────────────────
:: Verified version matrix
::
::  torch            2.4.1+cu121   CUDA 12.1
::  torchvision      0.19.1+cu121  must match torch 2.4.1
::  torchaudio       2.4.1+cu121   must match torch 2.4.1
::  diffusers        0.29.2
::  huggingface_hub  0.24.6        pinned -- do NOT upgrade
::  transformers     4.43.4
::  tokenizers       0.19.1
::  safetensors      0.4.3
::  accelerate       0.32.1
::  numpy            1.26.4        torch 2.4.x requires <2.0
::  pillow           10.3.0
::  imageio          2.33.1
::  imageio-ffmpeg   0.4.9
::  fastapi          0.111.0
::  uvicorn          0.29.0
::  pydantic         2.7.1
::  requests         2.31.0
::  python-dotenv    1.0.1
::
::  Models:
::  SD model : Lykon/DreamShaper                       (~2 GB, excellent realism)
::  VAE      : stabilityai/sd-vae-ft-ema              (~335 MB)
::  LLM      : mistral:latest                        (Ollama, ~4.1 GB, uncensored)
::  GIFs     : generated by SD pipeline directly (no extra model needed)
:: ─────────────────────────────────────────────────────────────

set OLLAMA_MODEL=mistral:latest
set SD_MODEL_ID=Lykon/DreamShaper
set SD_MODEL_PATH=models\dreamshaper
set VAE_MODEL_ID=stabilityai/sd-vae-ft-ema
set VAE_MODEL_PATH=models\vae

:: ─────────────────────────────────────────────
:: Step 1 -- Check Python 3.10
:: ─────────────────────────────────────────────
echo [Step 1] Checking Python...
python --version >nul 2>&1
if errorlevel 1 (
    echo ERROR: Python not found in PATH.
    echo Install Python 3.10 from https://www.python.org/downloads/release/python-3100/
    echo Tick "Add Python to PATH" during install.
    pause & exit /b 1
)
for /f "tokens=2 delims= " %%a in ('python --version 2^>^&1') do set PY_VER=%%a
for /f "tokens=1,2 delims=." %%a in ("%PY_VER%") do set PY_MAJOR_MINOR=%%a.%%b
if "%PY_MAJOR_MINOR%" neq "3.10" (
    echo ERROR: Python 3.10.x required, found %PY_VER%.
    pause & exit /b 1
)
echo Python %PY_VER% -- OK

:: ─────────────────────────────────────────────
:: Step 2 -- Virtual environment
:: ─────────────────────────────────────────────
echo.
echo [Step 2] Setting up virtual environment...
if not exist venv (
    python -m venv venv
    if errorlevel 1 ( echo ERROR: venv creation failed. & pause & exit /b 1 )
    echo Virtual environment created.
) else (
    echo Virtual environment already exists -- skipping.
)
call venv\Scripts\activate
if errorlevel 1 ( echo ERROR: Could not activate venv. & pause & exit /b 1 )

:: ─────────────────────────────────────────────
:: Step 3 -- Upgrade pip + build tools
:: ─────────────────────────────────────────────
echo.
echo [Step 3] Upgrading pip and build tools...
python -m pip install --upgrade pip setuptools wheel --quiet
echo Done.

:: ─────────────────────────────────────────────
:: Step 4 -- Wipe conflicting packages
:: ─────────────────────────────────────────────
echo.
echo [Step 4] Removing any conflicting existing packages...
pip uninstall torch torchvision torchaudio ^
    diffusers transformers huggingface_hub ^
    tokenizers safetensors accelerate ^
    -y --quiet >nul 2>&1
echo Done (errors above are harmless if packages did not exist).

:: ─────────────────────────────────────────────
:: Step 5 -- PyTorch 2.4.1 + CUDA 12.1
:: ─────────────────────────────────────────────
echo.
echo [Step 5] Installing PyTorch 2.4.1 (CUDA 12.1) -- ~2.5 GB...
pip install ^
    torch==2.4.1+cu121 ^
    torchvision==0.19.1+cu121 ^
    torchaudio==2.4.1+cu121 ^
    --index-url https://download.pytorch.org/whl/cu121 ^
    --quiet
if errorlevel 1 ( echo ERROR: PyTorch install failed. & pause & exit /b 1 )
echo PyTorch 2.4.1+cu121 installed.

:: ─────────────────────────────────────────────
:: Step 6 -- Verify CUDA
:: ─────────────────────────────────────────────
echo.
echo [Step 6] Verifying CUDA...
python -c "import torch; c=torch.cuda.is_available(); print('  CUDA available :', c); print('  GPU            :', torch.cuda.get_device_name(0) if c else 'None'); print('  Torch version  :', torch.__version__)"
if errorlevel 1 ( echo WARNING: CUDA check failed -- will fall back to CPU. )

:: ─────────────────────────────────────────────
:: Step 7 -- ML dependencies (strict order)
:: ─────────────────────────────────────────────
echo.
echo [Step 7] Installing ML dependencies (strict order)...

echo   [7a] numpy, pillow...
pip install numpy==1.26.4 pillow==10.3.0 --quiet
if errorlevel 1 ( echo ERROR: numpy/pillow failed. & pause & exit /b 1 )

echo   [7b] huggingface_hub 0.24.6 (pinned -- do NOT upgrade)...
pip install huggingface_hub==0.24.6 --quiet
if errorlevel 1 ( echo ERROR: huggingface_hub failed. & pause & exit /b 1 )

echo   [7c] tokenizers, safetensors...
pip install tokenizers==0.19.1 safetensors==0.4.3 --quiet
if errorlevel 1 ( echo ERROR: tokenizers/safetensors failed. & pause & exit /b 1 )

echo   [7d] transformers...
pip install transformers==4.43.4 --quiet
if errorlevel 1 ( echo ERROR: transformers failed. & pause & exit /b 1 )

echo   [7e] accelerate...
pip install accelerate==0.32.1 --quiet
if errorlevel 1 ( echo ERROR: accelerate failed. & pause & exit /b 1 )

echo   [7f] diffusers 0.29.2...
pip install diffusers==0.29.2 --quiet
if errorlevel 1 ( echo ERROR: diffusers failed. & pause & exit /b 1 )

echo   [7g] imageio (used by PIL GIF assembly)...
pip install imageio==2.33.1 imageio-ffmpeg==0.4.9 --quiet
if errorlevel 1 ( echo ERROR: imageio failed. & pause & exit /b 1 )

echo   ML dependencies installed.

:: ─────────────────────────────────────────────
:: Step 8 -- API dependencies
:: ─────────────────────────────────────────────
echo.
echo [Step 8] Installing API dependencies...
pip install ^
    pydantic==2.7.1 ^
    fastapi==0.111.0 ^
    "uvicorn[standard]==0.29.0" ^
    requests==2.31.0 ^
    python-dotenv==1.0.1 ^
    --quiet
if errorlevel 1 ( echo ERROR: API dependencies failed. & pause & exit /b 1 )
echo   API dependencies installed.

:: ─────────────────────────────────────────────
:: Step 9 -- Smoke-test all imports
:: ─────────────────────────────────────────────
echo.
echo [Step 9] Smoke-testing all imports...
python -c "import torch, diffusers, transformers, accelerate, huggingface_hub; import fastapi, uvicorn, dotenv, imageio; from PIL import Image; print('  torch:           ', torch.__version__); print('  diffusers:       ', diffusers.__version__); print('  fastapi:         ', fastapi.__version__); c=torch.cuda.is_available(); print('  CUDA ready:      ', c); print('All imports OK.')"
if errorlevel 1 (
    echo ERROR: Import smoke-test failed -- fix errors above before continuing.
    pause & exit /b 1
)

:: ─────────────────────────────────────────────
:: Step 10 -- Ollama check
:: ─────────────────────────────────────────────
echo.
echo [Step 10] Checking Ollama...
where ollama >nul 2>&1
if errorlevel 1 (
    echo ERROR: Ollama not found. Download from https://ollama.com/download
    pause & exit /b 1
)
echo   Ollama executable found.
curl -sf http://localhost:11434/ >nul 2>&1
if errorlevel 1 (
    echo ERROR: Ollama service is not running.
    echo Start it with: ollama serve   -- in a separate terminal, or from the Start Menu.
    pause & exit /b 1
)
ollama list | findstr /i /c:"%OLLAMA_MODEL%" >nul
if errorlevel 1 (
    echo Pulling "%OLLAMA_MODEL%" -- ~4.1 GB...
    ollama pull %OLLAMA_MODEL%
    if errorlevel 1 ( echo ERROR: Ollama pull failed. & pause & exit /b 1 )
    echo Ollama model ready.
) else (
    echo Ollama model "%OLLAMA_MODEL%" already present -- skipping.
)
python -c "import requests; r=requests.post('http://localhost:11434/api/generate', json={'model':'mistral:latest','prompt':'hi','stream':False}, timeout=30); r.raise_for_status(); print('  Ollama API -- OK')"
if errorlevel 1 ( echo ERROR: Ollama API test failed. & pause & exit /b 1 )

:: ─────────────────────────────────────────────
:: Step 11 -- DreamShaper SD model (~2 GB)
:: ─────────────────────────────────────────────
echo.
echo [Step 11] Checking DreamShaper model...
if not exist "%SD_MODEL_PATH%\model_index.json" (
    echo Downloading DreamShaper to %SD_MODEL_PATH%\ -- ~2 GB...
    python -c "from diffusers import StableDiffusionPipeline; pipe = StableDiffusionPipeline.from_pretrained('%SD_MODEL_ID%'); pipe.save_pretrained(r'%SD_MODEL_PATH%'); print('SD model saved.')"
    if errorlevel 1 ( echo ERROR: SD model download failed. & pause & exit /b 1 )
    echo DreamShaper model downloaded.
) else (
    echo DreamShaper model already present -- skipping.
)

:: ─────────────────────────────────────────────
:: Step 12 -- VAE model (~335 MB)
::            Required for sharp faces with noVAE edition
:: ─────────────────────────────────────────────
echo.
echo [Step 12] Checking VAE model (EMA edition for sharpness)...
if not exist "%VAE_MODEL_PATH%\config.json" (
    echo Downloading VAE to %VAE_MODEL_PATH%\ -- ~335 MB...
    python -c "from diffusers import AutoencoderKL; vae = AutoencoderKL.from_pretrained('%VAE_MODEL_ID%'); vae.save_pretrained(r'%VAE_MODEL_PATH%'); print('VAE saved.')"
    if errorlevel 1 ( echo ERROR: VAE download failed. & pause & exit /b 1 )
    echo VAE EMA downloaded.
) else (
    echo VAE EMA already present -- skipping.
)

:: ─────────────────────────────────────────────
:: Step 13 -- AnimateDiff not used
::            GIFs are generated by the SD pipeline
::            directly (4 frames x 20 steps, PIL assembly).
::            No extra model or VRAM swapping needed.
::            Saves ~200 MB download and ~30s swap overhead.
:: ─────────────────────────────────────────────
echo.
echo [Step 13] AnimateDiff not used -- GIFs use SD pipeline directly. Skipping.

:: ─────────────────────────────────────────────
:: Step 14 -- backend\.env (always overwrite)
:: ─────────────────────────────────────────────
echo.
echo [Step 14] Writing backend\.env...
if not exist backend mkdir backend
(
    echo BASE_URL=http://127.0.0.1:8000
    echo OLLAMA_URL=http://localhost:11434/api/generate
    echo MODEL_NAME=mistral:latest
    echo SD_PATH=models/dreamshaper
    echo VAE_PATH=models/vae
) > backend\.env
echo backend\.env written:
type backend\.env

:: ─────────────────────────────────────────────
:: Step 15 -- ai-friend\.env (only if missing)
:: ─────────────────────────────────────────────
echo.
echo [Step 15] Creating ai-friend\.env...
if not exist "ai-friend\.env" (
    if not exist ai-friend mkdir ai-friend
    >"ai-friend\.env" echo REACT_APP_API_URL=http://127.0.0.1:8000
    echo ai-friend\.env created.
) else (
    echo ai-friend\.env already exists -- skipping.
)

:: ─────────────────────────────────────────────
:: Step 16 -- npm install
:: ─────────────────────────────────────────────
echo.
echo [Step 16] Installing React dependencies in ai-friend\...
where npm >nul 2>&1
if errorlevel 1 (
    echo WARNING: npm not found -- skipping React install.
    echo Install Node.js 18+ from https://nodejs.org then run:
    echo   cd ai-friend ^&^& npm install ^&^& npm install @mui/icons-material
) else (
    pushd ai-friend
    echo   Running npm install...
    call npm install --silent
    if errorlevel 1 ( popd & echo ERROR: npm install failed. & pause & exit /b 1 )
    echo   Installing MUI icons...
    call npm install @mui/icons-material --silent
    if errorlevel 1 ( popd & echo ERROR: MUI icons install failed. & pause & exit /b 1 )
    popd
    echo   React dependencies installed.
)

:: ─────────────────────────────────────────────
:: Done
:: ─────────────────────────────────────────────
echo.
echo ============================================================
echo  Setup complete!
echo.
echo  Python packages:
echo    torch            2.4.1+cu121
echo    diffusers        0.29.2
echo    huggingface_hub  0.24.6  ^<-- do NOT pip upgrade this
echo    transformers     4.43.4
echo    accelerate       0.32.1
echo    numpy            1.26.4
echo    imageio          2.33.1
echo    fastapi          0.111.0  /  uvicorn 0.29.0
echo    pydantic         2.7.1
echo.
echo  Models downloaded:
echo    LLM  : mistral:latest                (Ollama, uncensored)
echo    SD   : DreamShaper                  (models\dreamshaper\)
echo    VAE  : sd-vae-ft-ema                (models\vae\)
echo    GIFs : SD pipeline (4 frames, no extra model needed)
echo.
echo  IMPORTANT: Do NOT run "pip install --upgrade" on this venv.
echo  huggingface_hub is intentionally pinned at 0.24.6.
echo.
echo  To start the app:
echo    Terminal 1:  startbot.bat
echo    Terminal 2:  cd ai-friend ^&^& npm start
echo.
echo  GIF keywords: gif, animate, dancing, walking, moving,
echo                motion, video, action
echo  Image keywords: image, picture, photo, pic, show me, draw
echo ============================================================
pause
endlocal
